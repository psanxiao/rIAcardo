# rIAcardo — entorno
# Copia este fichero a .env y rellena los valores.
#   cp .env.example .env

# --- PostgreSQL ---
# Coincide con los valores por defecto de docker-compose.yml
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DATABASE=riacardo
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Pool de conexiones (opcional)
DB_POOL_MIN=2
DB_POOL_MAX=10

# --- Seguridad ---
# Generar ENCRYPTION_KEY con:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=
# Generar JWT_SECRET_KEY con:
#   openssl rand -hex 32
JWT_SECRET_KEY=

# --- Coach IA (Groq) ---
# Obtén una API key en https://console.groq.com/
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# --- CORS adicional (opcional) ---
# Orígenes extra separados por comas, además de localhost y el rango Tailscale.
# Ej: http://192.168.1.100:9000,https://mi-dominio.com
ALLOWED_ORIGINS=
